@model MecanicoVm
@{
    ViewData["Title"] = "Nuevo Mecánico";
}

<h2 class="mb-3">Registrar Mecánico</h2>
<div class="card border-0 shadow-sm p-4 col-md-6">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="NombreCompleto" class="form-label">Nombre completo</label>
            <input asp-for="NombreCompleto" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Especialidad" class="form-label">Especialidad</label>
            <input asp-for="Especialidad" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Telefono" class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Correo</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Activo</label>
        </div>
        <button type="submit" class="btn btn-danger">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
