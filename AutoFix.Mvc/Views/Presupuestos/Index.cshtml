@model List<PresupuestoVm>
@{
    ViewData["Title"] = "Presupuestos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Presupuestos</h2>
    @if (Api.TienePermiso("Ordenes.Editar"))
    {
        <a asp-action="Create" class="btn btn-danger">+ Nuevo Presupuesto</a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Orden</th>
                    <th>Cliente / Vehículo</th>
                    <th>Mano de Obra</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td class="fw-bold">@p.NumeroOrden</td>
                        <td>@p.ClienteNombre <small class="text-muted d-block">@p.VehiculoPlaca</small></td>
                        <td>$@p.ManoDeObra.ToString("F2")</td>
                        <td class="fw-bold text-danger">$@p.Total.ToString("F2")</td>
                        <td>
                            <span class="badge @(p.Aprobado ? "bg-success" : "bg-warning text-dark")">
                                @(p.Aprobado ? "Aprobado" : "Pendiente")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Ver detalle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
