@model PresupuestoVm
@{
    ViewData["Title"] = $"Presupuesto #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Presupuesto #@Model.Id — Orden @Model.NumeroOrden</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm p-4">
    <div class="row mb-3">
        <div class="col-md-4"><strong>Cliente:</strong> @Model.ClienteNombre</div>
        <div class="col-md-4"><strong>Vehículo:</strong> @Model.VehiculoPlaca</div>
        <div class="col-md-4">
            <strong>Estado:</strong>
            <span class="badge @(Model.Aprobado ? "bg-success" : "bg-warning text-dark")">
                @(Model.Aprobado ? $"Aprobado por {Model.AprobadoPor}" : "Pendiente de aprobación")
            </span>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr><th>Código</th><th>Repuesto</th><th>Cantidad</th><th>Precio Unit.</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Repuestos)
            {
                <tr>
                    <td>@item.RepuestoCodigo</td>
                    <td>@item.RepuestoNombre</td>
                    <td>@item.Cantidad</td>
                    <td>$@item.PrecioUnitario.ToString("F2")</td>
                    <td>$@item.Subtotal.ToString("F2")</td>
                </tr>
            }
            <tr>
                <td colspan="4" class="text-end fw-bold">Mano de Obra</td>
                <td class="fw-bold">$@Model.ManoDeObra.ToString("F2")</td>
            </tr>
            <tr class="table-dark">
                <td colspan="4" class="text-end fw-bold">TOTAL</td>
                <td class="fw-bold">$@Model.Total.ToString("F2")</td>
            </tr>
        </tbody>
    </table>

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <p class="text-muted"><strong>Observaciones:</strong> @Model.Observaciones</p>
    }

    @if (!Model.Aprobado && Api.TienePermiso("Ordenes.Aprobar"))
    {
        <form asp-action="Aprobar" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Aprobar Presupuesto y Descontar Repuestos</button>
        </form>
    }
</div>
