@model List<RepuestoVm>
@{
    ViewData["Title"] = "Inventario de Repuestos";
    bool soloAlertas = ViewBag.SoloAlertas ?? false;
    var puedeGestionar = Api.TienePermiso("Inventario.Gestionar");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inventario de Repuestos</h2>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-soloAlertas="@(!soloAlertas)" class="btn @(soloAlertas ? "btn-warning" : "btn-outline-warning")">
            @(soloAlertas ? "Ver Todos" : "Solo Alertas Stock Mínimo")
        </a>
        @if (puedeGestionar)
        {
            <a asp-action="Create" class="btn btn-danger">+ Nuevo Repuesto</a>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Foto</th>
                    <th>Código</th>
                    <th>Repuesto</th>
                    <th>Categoría / Marca</th>
                    <th>Precio</th>
                    <th>Existencias / Mín.</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@(r.AlertaStockMinimo ? "table-warning" : "")">
                        <td>
                            @if (!string.IsNullOrEmpty(r.FotografiaRuta))
                            {
                                <img src="@($"{Api.ApiBaseUrl}/{r.FotografiaRuta}")" style="width:45px;height:45px;object-fit:cover;" class="rounded" alt="@r.Codigo" />
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="fw-bold">@r.Codigo</td>
                        <td>
                            @r.Nombre
                            <small class="text-muted d-block">@r.Descripcion</small>
                        </td>
                        <td>@r.Categoria · @r.Marca</td>
                        <td>$@r.Precio.ToString("F2")</td>
                        <td class="fw-bold">@r.Existencias / @r.StockMinimo</td>
                        <td>
                            @if (r.AlertaStockMinimo)
                            {
                                <span class="badge bg-danger">STOCK MÍNIMO</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="Movimientos" asp-action="Create" asp-route-repuestoId="@r.Id" asp-route-tipo="Salida" class="btn btn-sm btn-outline-primary">Usar</a>
                            @if (puedeGestionar)
                            {
                                <a asp-controller="Movimientos" asp-action="Create" asp-route-repuestoId="@r.Id" asp-route-tipo="Entrada" class="btn btn-sm btn-outline-success">Entrada</a>
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
