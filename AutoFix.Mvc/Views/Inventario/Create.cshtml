@model RepuestoVm
@{
    ViewData["Title"] = "Nuevo Repuesto";
}

<h2 class="mb-3">Registrar Repuesto</h2>
<div class="card border-0 shadow-sm p-4 col-md-7">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Codigo" class="form-label">Código</label>
                <input asp-for="Codigo" class="form-control" />
            </div>
            <div class="col-md-8 mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" rows="2" class="form-control"></textarea>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Categoria" class="form-label">Categoría</label>
                <input asp-for="Categoria" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Marca" class="form-label">Marca</label>
                <input asp-for="Marca" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Precio" class="form-label">Precio ($)</label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Existencias" class="form-label">Existencias</label>
                <input asp-for="Existencias" type="number" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
                <input asp-for="StockMinimo" type="number" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Fotografía (JPG/PNG máx. 5 MB)</label>
            <input type="file" name="foto" class="form-control" accept=".jpg,.jpeg,.png" />
        </div>
        <button type="submit" class="btn btn-danger">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
