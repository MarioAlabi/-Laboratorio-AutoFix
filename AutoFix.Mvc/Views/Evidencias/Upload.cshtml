@{
    ViewData["Title"] = "Subir Evidencia";
    var ordenes = ViewBag.Ordenes as List<OrdenVm> ?? [];
    int? ordenIdPre = ViewBag.OrdenId;
}

<h2 class="mb-3">Subir Evidencia Fotográfica</h2>
<div class="card border-0 shadow-sm p-4 col-md-6">
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Orden de reparación</label>
            <select name="ordenId" class="form-select" required>
                <option value="">-- Seleccione orden --</option>
                @foreach (var o in ordenes)
                {
                    <option value="@o.Id" selected="@(ordenIdPre == o.Id)">@o.NumeroOrden — @o.VehiculoPlaca</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Categoría</label>
            <select name="categoria" class="form-select" required>
                <option value="VehiculoIngreso">Vehículo al ingresar</option>
                <option value="DanioIdentificado">Daños identificados</option>
                <option value="RepuestoUtilizado">Repuestos utilizados</option>
                <option value="ReparacionFinalizada">Reparación finalizada</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <input type="text" name="descripcion" class="form-control" placeholder="Ej: Rayón en puerta trasera derecha" />
        </div>
        <div class="mb-3">
            <label class="form-label">Imagen (JPG, JPEG o PNG, máx. 5 MB)</label>
            <input type="file" name="archivo" class="form-control" accept=".jpg,.jpeg,.png" required />
        </div>
        <button type="submit" class="btn btn-danger">Subir Fotografía</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
