@model List<EvidenciaVm>
@{
    ViewData["Title"] = "Evidencias Fotográficas";
    var ordenes = ViewBag.Ordenes as List<OrdenVm> ?? [];
    int? ordenFiltro = ViewBag.OrdenIdFiltro;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Evidencias Fotográficas</h2>
    @if (Api.ObtenerRol() != "Cliente")
    {
        <a asp-action="Upload" class="btn btn-danger">+ Subir Evidencia</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="ordenId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Todas las órdenes --</option>
            @foreach (var o in ordenes)
            {
                <option value="@o.Id" selected="@(ordenFiltro == o.Id)">@o.NumeroOrden — @o.VehiculoPlaca</option>
            }
        </select>
    </div>
</form>

<div class="row g-3">
    @foreach (var ev in Model)
    {
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <img src="@($"{Api.ApiBaseUrl}/{ev.Ruta}")" class="card-img-top" style="height:180px;object-fit:cover;" alt="@ev.Categoria" />
                <div class="card-body">
                    <span class="badge bg-dark mb-1">@ev.Categoria</span>
                    <p class="small mb-1"><strong>Orden #@ev.OrdenReparacionId</strong></p>
                    <p class="small text-muted mb-1">@ev.Descripcion</p>
                    <small class="text-muted d-block">@ev.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</small>
                    <small class="text-muted">Por: @(ev.SubidoPor ?? "N/A")</small>
                </div>
            </div>
        </div>
    }
</div>
