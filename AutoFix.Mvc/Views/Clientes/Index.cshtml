@model List<ClienteVm>
@{
    ViewData["Title"] = "Clientes";
    var puedeEditar = Api.TieneRol("Administrador", "Recepcionista");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    @if (puedeEditar)
    {
        <a asp-action="Create" class="btn btn-danger">+ Nuevo Cliente</a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>DUI</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Vehículos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.NombreCompleto</td>
                        <td>@c.Dui</td>
                        <td>@c.Telefono</td>
                        <td>@c.CorreoElectronico</td>
                        <td><span class="badge bg-primary">@c.Vehiculos.Count</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">Ver</a>
                            @if (puedeEditar)
                            {
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            }
                            @if (Api.TieneRol("Administrador"))
                            {
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar cliente?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
