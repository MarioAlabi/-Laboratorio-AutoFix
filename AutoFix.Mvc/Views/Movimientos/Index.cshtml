@model List<MovimientoVm>
@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Movimientos de Inventario (Entradas y Salidas)</h2>
    <a asp-action="Create" class="btn btn-danger">+ Registrar Movimiento</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Repuesto</th>
                    <th>Cantidad</th>
                    <th>Orden</th>
                    <th>Usuario</th>
                    <th>Observación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge @(m.Tipo == "Entrada" ? "bg-success" : "bg-danger")">@m.Tipo</span>
                        </td>
                        <td>@m.RepuestoCodigo — @m.RepuestoNombre</td>
                        <td class="fw-bold">@m.Cantidad</td>
                        <td>@(m.OrdenReparacionId.HasValue ? $"#{m.OrdenReparacionId}" : "—")</td>
                        <td>@(m.UsuarioEmail ?? "—")</td>
                        <td>@m.Observacion</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
